{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "podium-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{
				"name": "MCP_OBJECT",
				"class_name": "PodiumMCP"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PodiumMCP"]
		}
	],
	"observability": {
		"enabled": true
	}
}
